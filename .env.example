# Skabelon. Kopiér til .env KUN på en lokal maskine/server (eller brug 'cvr-radar setup-local').
# I Claude Code cloud sættes værdierne i stedet under miljøets "Environment variables".
# .env er udelukket fra Git. Læg aldrig rigtige værdier i denne fil.

CVR_USERNAME=
CVR_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Valgfrie (standardværdier vist):
# CVR_BASE_URL=https://distribution.virk.dk
# CVR_INDEX=cvr-permanent/virksomhed
# HTTP_TIMEOUT_SECONDS=20
